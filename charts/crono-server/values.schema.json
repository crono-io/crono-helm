{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "crono-server chart values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replicaCount",
    "image",
    "database",
    "nats"
  ],
  "properties": {
    "global": {
      "type": "object"
    },
    "enabled": {
      "type": "boolean",
      "description": "Dependency condition for umbrella charts; ignored by this chart."
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name"
            ]
          }
        ]
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "crono-server image repository"
        },
        "tag": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$",
          "description": "Defaults to the chart appVersion; ignored when digest is set."
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$",
          "description": "Pins repository@digest when set."
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "repository"
      ]
    },
    "requireImageDigest": {
      "type": "boolean"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "type",
        "port"
      ]
    },
    "resources": {
      "type": "object"
    },
    "preStopSleepSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "maxSkew": {
            "type": "integer",
            "minimum": 1
          },
          "topologyKey": {
            "type": "string",
            "minLength": 1
          },
          "whenUnsatisfiable": {
            "enum": [
              "DoNotSchedule",
              "ScheduleAnyway"
            ]
          }
        },
        "required": [
          "maxSkew",
          "topologyKey",
          "whenUnsatisfiable"
        ]
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      },
      "required": [
        "enabled",
        "minAvailable"
      ]
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "host": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "pathType": {
          "enum": [
            "Prefix",
            "Exact",
            "ImplementationSpecific"
          ]
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            }
          }
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "existingSecret": {
      "type": "string"
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authToken": {
          "type": "string",
          "maxLength": 8192
        },
        "databasePassword": {
          "type": "string"
        },
        "natsNkeySeed": {
          "type": "string"
        },
        "natsCreds": {
          "type": "string"
        },
        "natsPassword": {
          "type": "string"
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "development"
          ]
        }
      },
      "required": [
        "mode"
      ]
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "description": "PostgreSQL host (required)."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "sslMode": {
          "enum": [
            "disable",
            "allow",
            "prefer",
            "require",
            "verify-ca",
            "verify-full"
          ]
        },
        "caSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "CA Secret name; empty uses webpki roots."
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "key"
          ]
        },
        "pool": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxConnections": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "minConnections": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200
            },
            "acquireTimeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "idleTimeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "maxLifetimeSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "required": [
        "host",
        "port",
        "name",
        "user",
        "sslMode"
      ]
    },
    "nats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(nats|tls)://[^@/]+$",
          "description": "NATS URL (required). Never embed credentials."
        },
        "replicas": {
          "enum": [
            1,
            3,
            5
          ]
        },
        "caSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "NATS CA Secret name; empty uses the built-in roots."
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "key"
          ]
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "none",
                "nkey",
                "creds",
                "userPassword"
              ]
            },
            "user": {
              "type": "string"
            }
          },
          "required": [
            "mode"
          ]
        }
      },
      "required": [
        "url",
        "replicas",
        "auth"
      ]
    },
    "logLevel": {
      "type": "string"
    },
    "otlpEndpoint": {
      "type": "string"
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "to": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "minProperties": 1
              }
            },
            "ports": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "port"
                ]
              }
            }
          },
          "required": [
            "to",
            "ports"
          ]
        },
        "ingressFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "metricsFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "postgresCIDRs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
          }
        },
        "nats": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaceSelector": {
              "type": "object"
            },
            "podSelector": {
              "type": "object"
            },
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
              }
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "required": [
            "port"
          ]
        },
        "extraEgress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ingress": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          }
        },
        "required": [
          "ingress"
        ]
      },
      "then": {
        "properties": {
          "ingress": {
            "required": [
              "host",
              "path",
              "pathType"
            ],
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "tls": {
                "if": {
                  "properties": {
                    "enabled": {
                      "const": true
                    }
                  },
                  "required": [
                    "enabled"
                  ]
                },
                "then": {
                  "required": [
                    "secretName"
                  ],
                  "properties": {
                    "secretName": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "nats": {
            "properties": {
              "auth": {
                "properties": {
                  "mode": {
                    "const": "userPassword"
                  }
                },
                "required": [
                  "mode"
                ]
              }
            },
            "required": [
              "auth"
            ]
          }
        },
        "required": [
          "nats"
        ]
      },
      "then": {
        "properties": {
          "nats": {
            "properties": {
              "auth": {
                "required": [
                  "user"
                ],
                "properties": {
                  "user": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
